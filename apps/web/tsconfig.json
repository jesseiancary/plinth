{
  "extends": "../../tsconfig.bundler.json",
  "compilerOptions": {
    /* React-specific */
    "useDefineForClassFields": true,
    "jsx": "react-jsx",

    /* DOM environment */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Vite-specific */
    "rootDir": "./src",

    /* Path aliases - resolved by Vite */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
