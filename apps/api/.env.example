# API Environment Variables
# DO NOT manually copy this file to .env - Run 'make setup' instead
#
# Database
# Must match POSTGRES_PASSWORD from root .env file
# SECURITY: Empty password intentionally fails Zod validation and PostgreSQL auth
#
# Auto-generated during 'make setup':
#   - DATABASE_URL: Uses hex password (64 chars, URL-safe, 256-bit entropy)
#   - JWT secrets: Use base64 (44 chars, 264-bit entropy, shorter but not in URLs)
#
# Manual generation (if needed):
#   DB:  openssl rand -hex 32     # URL-safe (no special chars)
#   JWT: openssl rand -base64 32  # Shorter (not used in URLs)
#
# Format: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:POSTGRES_PORT/POSTGRES_DB
DATABASE_URL=postgresql://plinth_dev:@db:5432/plinth_dev

# JWT Secrets
# SECURITY: Empty secrets intentionally fail Zod validation
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email
# Transport: "smtp" (default) for local dev via the Mailpit container (see docker-compose.yml) —
# all mail is captured at http://localhost:8025, no real credentials needed. Production uses
# "ses" (the SES HTTPS API) because Railway's Hobby plan blocks outbound SMTP.
EMAIL_TRANSPORT=smtp
# SMTP settings (used when EMAIL_TRANSPORT=smtp).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# SES HTTPS API settings (required when EMAIL_TRANSPORT=ses). IAM access key with ses:SendEmail;
# region must match the verified SES identity (e.g. us-west-1).
# AWS_REGION=us-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# "From" address on outbound email (optional; defaults to a local placeholder). In production it
# must be a verified SES sender, e.g. Plinth <noreply@yourdomain.com>.
EMAIL_FROM=Plinth <noreply@plinth.local>

# URLs
API_URL=https://localhost
# Frontend base URL used to build links inside emails (verify/reset/invite)
WEB_URL=https://localhost

# Environment
NODE_ENV=development
PORT=3000

# Logging (optional)
# Options: error | warn | info | http | debug
# Default: info (production), debug (development), silent (test)
LOG_LEVEL=info

# Health check (optional)
# Shared bearer token that gates GET /health/detailed (memory, uptime, DB latency, versions).
# Leave unset to disable the detailed endpoint (it returns 404). Basic GET /health stays public.
# Generate with: openssl rand -base64 32
HEALTH_CHECK_TOKEN=
