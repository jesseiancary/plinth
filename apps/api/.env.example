# API Environment Variables
# DO NOT manually copy this file to .env - Run 'make setup' instead
#
# Database
# Must match POSTGRES_PASSWORD from root .env file
# SECURITY: Empty password intentionally fails Zod validation and PostgreSQL auth
#
# Auto-generated during 'make setup':
#   - DATABASE_URL: Uses hex password (64 chars, URL-safe, 256-bit entropy)
#   - JWT secrets: Use base64 (44 chars, 264-bit entropy, shorter but not in URLs)
#
# Manual generation (if needed):
#   DB:  openssl rand -hex 32     # URL-safe (no special chars)
#   JWT: openssl rand -base64 32  # Shorter (not used in URLs)
#
# Format: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:POSTGRES_PORT/POSTGRES_DB
DATABASE_URL=postgresql://plinth_dev:@db:5432/plinth_dev

# JWT Secrets
# SECURITY: Empty secrets intentionally fail Zod validation
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# URLs
API_URL=https://localhost

# Environment
NODE_ENV=development
PORT=3000

# Logging (optional)
# Options: error | warn | info | http | debug
# Default: info (production), debug (development), silent (test)
LOG_LEVEL=info
