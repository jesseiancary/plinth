generator client {
  provider = "prisma-client"
  output   = "./generated/client"
  // Emit .js import specifiers in the generated client. The prisma-client generator
  // otherwise defaults to .ts extensions, which tsc preserves verbatim into the compiled
  // output — so `node` can't resolve them in the production image (ERR_MODULE_NOT_FOUND).
  // .js is the NodeNext convention: tsc compiles it cleanly and tsx remaps it in dev.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER // Full control, cannot be removed, can transfer ownership
  ADMIN // Manage members/invitations, cannot demote owner
  MEMBER // Read access to org resources
}

enum InvitationStatus {
  PENDING // Invite created, not yet accepted
  ACCEPTED // Invite accepted, membership created
  REVOKED // Invite manually revoked by admin
  EXPIRED // Invite expired (72h), not accepted in time
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255) // bcrypt hash
  name         String   @db.VarChar(255)
  tokenVersion Int      @default(0) // Increment to invalidate all refresh tokens

  emailVerified Boolean @default(false) // Set true at account materialization; login is gated on this

  // Self-service password reset. Only the SHA-256 hash of the emailed token is persisted
  // (consistent with Invitation.tokenHash); the plaintext travels only in the reset link.
  // `@unique` enforces single-issuance at the DB level (matching every other single-use
  // secret-hash column) and indexes the lookup; Postgres permits many NULLs under it, which is
  // the common state. Single-use: both fields cleared on consumption.
  passwordResetTokenHash String?   @unique @db.VarChar(64)
  passwordResetExpiresAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  memberships        Membership[]
  createdInvitations Invitation[] @relation("InvitationCreatedBy")

  @@index([email])
  @@map("users")
}

// A registration awaiting email verification. The real User (+ personal Organization +
// OWNER Membership) is materialized only when the emailed link is clicked, so email
// ownership — not registration order — decides who controls an account. Multiple pending
// rows per email can coexist; each carries its own password hash and single-use token, so a
// click can only ever activate the credentials that link was issued for.
model PendingRegistration {
  id                    String   @id @default(cuid())
  email                 String   @db.VarChar(255) // NOT unique — multiple pendings per email allowed
  name                  String   @db.VarChar(255)
  passwordHash          String   @db.VarChar(255) // bcrypt hash of the submitted password
  verificationTokenHash String   @unique @db.VarChar(64) // SHA-256 of the emailed token; single-use
  expiresAt             DateTime @db.Timestamptz
  createdAt             DateTime @default(now()) @db.Timestamptz

  @@index([email])
  @@index([expiresAt])
  @@map("pending_registrations")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255) // Globally unique, URL-safe identifier
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  memberships Membership[]
  invitations Invitation[]
  apiKeys     ApiKey[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(cuid())
  email          String           @db.VarChar(255) // Email of invitee
  role           Role             @default(MEMBER)
  tokenHash      String           @unique @db.VarChar(64) // SHA-256 hash (64 hex chars)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @db.Timestamptz // 72 hours from creation
  acceptedAt     DateTime?        @db.Timestamptz // Timestamp when accepted (single-use enforcement)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User             @relation("InvitationCreatedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @db.Timestamptz

  @@index([organizationId, status])
  @@index([email, organizationId, status])
  @@index([expiresAt])
  @@map("invitations")
}

model ApiKey {
  id             String       @id @default(cuid())
  name           String       @db.VarChar(255) // Human-readable name (e.g., "Production API", "CI/CD")
  keyHash        String       @unique @db.VarChar(64) // SHA-256 hash (64 hex chars)
  scopes         String[]     @default([]) // e.g., ["members:read", "org:read"]
  lastUsedAt     DateTime?    @db.Timestamptz // Track last usage for security auditing
  revokedAt      DateTime?    @db.Timestamptz // Soft delete: allows audit trail
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@index([organizationId])
  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String    @db.VarChar(50) // e.g., "stripe", "github"
  eventType      String    @db.VarChar(100) // e.g., "invoice.paid"
  payload        Json // Full webhook payload
  idempotencyKey String    @unique @db.VarChar(255) // Provider-specific event ID
  processedAt    DateTime? @db.Timestamptz // NULL = pending, timestamp = processed
  createdAt      DateTime  @default(now()) @db.Timestamptz

  @@index([provider, eventType])
  @@index([processedAt])
  @@map("webhook_events")
}
