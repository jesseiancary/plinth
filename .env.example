# Docker Compose Environment Variables
# DO NOT manually copy this file to .env - Run 'make setup' instead
#
# PostgreSQL Database Credentials
# SECURITY: Empty password intentionally fails PostgreSQL authentication
# This prevents accidental use of placeholder credentials in production
#
# Auto-generated during 'make setup':
#   - openssl rand -hex 32 (64 chars, 256-bit entropy, URL-safe)
#
# Manual generation (if needed):
#   openssl rand -hex 32
#
# These values are used by docker-compose.yml for container configuration.
# The same credentials should be referenced in apps/api/.env DATABASE_URL.
POSTGRES_USER=plinth_dev
POSTGRES_PASSWORD=
POSTGRES_DB=plinth_dev
POSTGRES_PORT=5432
